# MediaHub LLM Gateway / New API
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=3000
GATEWAY_URL=http://127.0.0.1:3000
TZ=Europe/Moscow
POSTGRES_USER=mediahub
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
POSTGRES_DB=new_api
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_64_HEX
CRYPTO_SECRET=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_TRUSTED_URL=
TRUSTED_PROXIES=none
NODE_NAME=mediahub-gateway
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
NEW_API_ADMIN_USERNAME=mediahub-admin
NEW_API_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Confirmed provider credentials
AIONLABS_API_KEY= # Aion Labs — ~20K/day
CF_ACCOUNT_ID_1= # Cloudflare account 1 — ~20-30K estimated/day
CF_ACCOUNT_ID_2= # Cloudflare account 2 — ~20-30K estimated/day
CF_API_TOKEN_1= # Cloudflare API token 1
CF_API_TOKEN_2= # Cloudflare API token 2
DEEPSEEK_API_KEY= # DeepSeek — ~5-10M/day while trial lasts
HF_TOKEN= # Hugging Face — ~2-5M/day estimate
KIMI_API_KEY= # Kimi — 1.5M TPD
LLM7_TOKEN= # LLM7 — 1M TPD
MISTRAL_KEY_1= # Mistral account 1 — ~33M/day sustainable average
MISTRAL_KEY_2= # Mistral account 2 — ~33M/day sustainable average
NARA_KEY_1= # NaraRouter key 1 — ~3-10M/day estimate
OPENROUTER_API_KEY= # OpenRouter — ~100K/day at current free limit
ORCA_KEY= # OrcaRouter — ~3-5M/day estimate
SAMBANOVA_KEY= # SambaNova — 200K TPD, 20 RPD
SILICON_KEY_1= # SiliconFlow account 1 — ~20-30M/day estimate
SILICON_KEY_2= # SiliconFlow account 2 — ~20-30M/day estimate
UNOROUTER_API_KEY= # UnoRouter — ~3-5M/day estimate
ZAI_KEY_1= # Z.ai account 1 — ~1-2M/day estimate
ZAI_KEY_2= # Z.ai account 2 — ~1-2M/day estimate
ZEROUTER_API_KEY= # ZeroRouter — ~3-5M/day estimate

# Test-and-skip
GEMINI_API_KEY=
GROQ_API_KEY=
HEALTH_CHECK_ENABLED=true

# Upstream base URLs
NARA_BASE_URL=https://api.naracode.com/v1
ORCA_BASE_URL=https://api.orcarouter.com/v1
LLM7_BASE_URL=https://api.llm7.io/v1
UNOROUTER_BASE_URL=https://api.unorouter.com/v1
ZEROUTER_BASE_URL=https://api.zerouter.ai/v1
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
NOUS_BASE_URL=
GIGACHAT_BASE_URL=https://api.giga.chat/v1
BOMB_BASE_URL=
NOVITA_BASE_URL=https://api.novita.ai/v3/openai
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 30 сентября: добавить NARA_KEY_2 и NARA_KEY_3
NARA_KEY_2=
NARA_KEY_3=

# 30 сентября: добавить DASHSCOPE_API_KEY
DASHSCOPE_API_KEY=
# 30 сентября: добавить NOUS_KEY
NOUS_KEY=
