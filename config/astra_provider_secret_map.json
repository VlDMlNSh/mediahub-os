{
  "schema_version": 1,
  "policy": "names-only-no-secret-values",
  "github_actions_secrets": {
    "anthropic": ["ANTHROPIC_API_KEY"],
    "gemini": ["GEMINI_API_KEY"],
    "groq": ["GROQ_API_KEY"],
    "huggingface": ["HF_TOKEN"],
    "openai": ["OPENAI_API_KEY"],
    "openrouter": ["OPENROUTER_API_KEY"],
    "tabby": ["TABITOKEN_API_KEY"],
    "together": ["TOGETHER_API_KEY"]
  },
  "local_policy": "github-actions-secrets-are-not-copied-to-host-environment",
  "runtime_injection": "only-through-supervised-agent-lane"
}
