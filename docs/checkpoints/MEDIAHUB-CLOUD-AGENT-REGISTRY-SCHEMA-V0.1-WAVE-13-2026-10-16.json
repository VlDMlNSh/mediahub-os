{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VlDMlNSh/mediahub-os/blob/docs/mediahub-chat-tree-map-20261012/docs/checkpoints/MEDIAHUB-CLOUD-AGENT-REGISTRY-SCHEMA-V0.1-WAVE-13-2026-10-16.json",
  "title": "MediaHub Cloud-Agent Registry Record v0.1",
  "description": "PROPOSED ONLY. Contour A registry schema for evidence-backed agent identity, narrow capability grants, provider route constraints, expiry and revocation. It does not register, authorize or connect an agent.",
  "$comment": "Runtime use is blocked until A0 issuer/admission/lifecycle, MH-12 security authority, R-06 audit/privacy and target manifest are accepted and independently qualified.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","agent_id","status","identity","capabilities","provider_routes","execution","authorization","lifecycle","evidence"],
  "properties": {
    "schema_version": {"const":"mediahub.cloud-agent-registry-record.v0.1"},
    "agent_id": {"type":"string","pattern":"^CAF-AGENT-[A-Z0-9][A-Z0-9-]{1,48}$","maxLength":64},
    "status": {"enum":["proposed","pending_review","authorized","suspended","revoked","expired"]},
    "identity": {
      "type":"object","additionalProperties":false,
      "required":["agent_class","provider_id","model_id","workflow_ref","workflow_sha"],
      "properties":{
        "agent_class":{"enum":["source_audit","documentation","design_proposal","patch_proposal","verification_review","isolated_patch_worker"]},
        "provider_id":{"type":"string","minLength":1,"maxLength":128},
        "model_id":{"type":"string","minLength":1,"maxLength":128},
        "workflow_ref":{"type":"string","minLength":1,"maxLength":512},
        "workflow_sha":{"type":"string","pattern":"^[a-f0-9]{40}$"},
        "runtime_image_digest":{"type":["string","null"],"pattern":"^sha256:[a-f0-9]{64}$"}
      }
    },
    "capabilities":{
      "type":"object","additionalProperties":false,
      "required":["task_types","allowed_paths","forbidden_paths","data_classes","max_changed_files","effects"],
      "properties":{
        "task_types":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["source_audit","documentation","design_proposal","patch_proposal","test_plan","verification_review"]}},
        "allowed_paths":{"type":"array","maxItems":100,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":512}},
        "forbidden_paths":{"type":"array","maxItems":100,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":512}},
        "data_classes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["public","internal","confidential","restricted"]}},
        "max_changed_files":{"type":"integer","minimum":0,"maximum":100},
        "effects":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["read_only","documentation_only","proposal_only","patch_branch","pull_request","test_execution"]}}
      }
    },
    "provider_routes":{
      "type":"array","maxItems":20,"items":{
        "type":"object","additionalProperties":false,
        "required":["provider_id","model_id","data_classes","purpose","policy_ref","authorization_ref","paid_fallback"],
        "properties":{
          "provider_id":{"type":"string","minLength":1,"maxLength":128},
          "model_id":{"type":"string","minLength":1,"maxLength":128},
          "data_classes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["public","internal","confidential","restricted"]}},
          "purpose":{"type":"string","minLength":1,"maxLength":512},
          "policy_ref":{"type":"string","minLength":1,"maxLength":512},
          "authorization_ref":{"type":"string","minLength":1,"maxLength":512},
          "paid_fallback":{"type":"boolean"}
        }
      }
    },
    "execution":{
      "type":"object","additionalProperties":false,
      "required":["max_concurrency","max_attempts","timeout_seconds","max_input_bytes","max_output_bytes","isolated_workspace_required"],
      "properties":{
        "max_concurrency":{"type":"integer","minimum":1,"maximum":100},
        "max_attempts":{"type":"integer","minimum":1,"maximum":10},
        "timeout_seconds":{"type":"integer","minimum":1,"maximum":86400},
        "max_input_bytes":{"type":"integer","minimum":1,"maximum":5242880},
        "max_output_bytes":{"type":"integer","minimum":1,"maximum":10485760},
        "isolated_workspace_required":{"const":true}
      }
    },
    "authorization":{
      "type":"object","additionalProperties":false,
      "required":["issuer_contract_ref","grant_ref","review_ref","scope_digest"],
      "properties":{
        "issuer_contract_ref":{"type":"string","minLength":1,"maxLength":512},
        "grant_ref":{"type":"string","minLength":1,"maxLength":512},
        "review_ref":{"type":"string","minLength":1,"maxLength":512},
        "scope_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}
      }
    },
    "lifecycle":{
      "type":"object","additionalProperties":false,
      "required":["issued_at","expires_at","revocation_ref","last_reviewed_at"],
      "properties":{
        "issued_at":{"type":"string","format":"date-time"},
        "expires_at":{"type":"string","format":"date-time"},
        "revocation_ref":{"type":"string","minLength":1,"maxLength":512},
        "last_reviewed_at":{"type":"string","format":"date-time"}
      }
    },
    "evidence":{
      "type":"array","minItems":1,"maxItems":100,
      "items":{"type":"object","additionalProperties":false,"required":["kind","ref","sha256"],"properties":{
        "kind":{"enum":["workflow_run","source_review","provider_policy","authorization","security_review","qualification","revocation"]},
        "ref":{"type":"string","minLength":1,"maxLength":1024},
        "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
      }}
    }
  }
}