{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VlDMlNSh/mediahub-os/blob/docs/mediahub-chat-tree-map-20261012/docs/checkpoints/MEDIAHUB-CLOUD-AGENT-EVIDENCE-MANIFEST-SCHEMA-V0.2-WAVE-16-2026-10-16.json",
  "title": "MediaHub Cloud-Agent Execution Evidence Manifest v0.2",
  "description": "PROPOSED ONLY. Versioned execution evidence manifest with separate verification and qualification records. It is not an authorization grant or qualification by itself.",
  "$comment": "Execution, verification, qualification, release, deployment and acceptance are distinct. Every external reference must be resolved and authorized by the consumer. Validator profile must enable Draft 2020-12 format assertion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "execution",
    "source",
    "inputs",
    "agent",
    "policy",
    "artifacts",
    "disposition",
    "review",
    "schema_refs",
    "verification",
    "qualification"
  ],
  "properties": {
    "schema_version": {
      "const": "mediahub.cloud-agent-evidence-manifest.v0.2"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_envelope_sha256",
        "attempt",
        "idempotency_key_digest"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^CAF-[A-Z0-9][A-Z0-9-]{2,63}$",
          "maxLength": 68
        },
        "task_envelope_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "idempotency_key_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_run_id",
        "job_id",
        "started_at",
        "finished_at",
        "status",
        "retry_count"
      ],
      "properties": {
        "provider_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "status": {
          "enum": [
            "accepted",
            "rejected",
            "running",
            "cancelled",
            "failed",
            "indeterminate",
            "completed"
          ]
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "sanitized_error_class": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "provider_request_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "requested_ref",
        "resolved_sha",
        "workflow_path",
        "workflow_blob_sha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "requested_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "resolved_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "workflow_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "workflow_blob_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "action_shas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$",
            "minLength": 40,
            "maxLength": 40
          }
        },
        "runner_image": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "runtime_metadata_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "inputs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "data_class"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10485760
          },
          "data_class": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted",
              "unknown"
            ]
          }
        }
      },
      "minItems": 0
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "provider_id",
        "model_id",
        "registry_record_sha256"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "pattern": "^CAF-AGENT-[A-Z0-9][A-Z0-9-]{1,48}$",
          "maxLength": 64
        },
        "provider_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "registry_record_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_authorization_ref",
        "provider_policy_ref",
        "data_policy_ref",
        "audit_policy_ref"
      ],
      "properties": {
        "task_authorization_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "provider_policy_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "data_policy_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "audit_policy_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "policy_bundle_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "media_type",
          "sha256",
          "bytes",
          "retention_class"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 52428800
          },
          "retention_class": {
            "enum": [
              "ephemeral",
              "short_term",
              "standard",
              "legal_hold"
            ]
          }
        }
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor_result",
        "promotion_state"
      ],
      "properties": {
        "executor_result": {
          "enum": [
            "success",
            "partial",
            "failed",
            "cancelled",
            "indeterminate"
          ]
        },
        "promotion_state": {
          "enum": [
            "quarantined",
            "awaiting_review",
            "approved_for_next_gate",
            "rejected",
            "reconciliation_required"
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "reviewer_identity_ref",
        "decision",
        "evidence_ref"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "reviewer_identity_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "decision": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "returned_for_revision"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "schema_refs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "sha256"
        ],
        "properties": {
          "name": {
            "enum": [
              "task_envelope",
              "agent_registry",
              "evidence_manifest",
              "policy_bundle"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "criteria_ref",
        "reviewer_identity_ref",
        "evidence_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed",
            "not_run"
          ]
        },
        "criteria_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "reviewer_identity_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "profile_ref",
        "decision_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "qualified",
            "rejected",
            "not_applicable"
          ]
        },
        "profile_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "decision_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        }
      }
    }
  }
}
