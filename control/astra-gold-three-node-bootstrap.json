{
  "schema": "mediahub.astra-gold.three-node-bootstrap.v1",
  "status": "INSTALL_PLAN_READY_NOT_INSTALLED",
  "source_of_truth": "control/node-role-manifest.json",
  "nodes": {
    "mh-dev-01": {
      "role": "control_transport",
      "install": [
        "Astra GitHub Agent",
        "Astra Command Bus",
        "Astra Orchestrator",
        "Hybrid Orchestrator",
        "Node.js",
        "Bun"
      ],
      "avoid": [
        "provider_execution",
        "G4_115_round_execution",
        "large_model_stores"
      ]
    },
    "mh-dev-02": {
      "role": "provider_execution",
      "install": [
        "Codex CLI",
        "Claude Code",
        "free-claude-code",
        "free-claude-code server",
        "OmniRoute",
        "OpenFlux",
        "free-coding-models",
        "Ollama",
        "llama.cpp",
        "bubblewrap",
        "FFmpeg",
        "OpenCV",
        "PaddleOCR"
      ],
      "qualification": [
        "local_component_runtime",
        "provider_model",
        "dual_local_executor_23wave"
      ]
    },
    "mh-dev-03": {
      "role": "qualification_recovery",
      "install": [
        "G4 verifier",
        "A3 verifier",
        "Prometheus",
        "PostgreSQL",
        "pgvector",
        "NATS",
        "etcd",
        "protobuf",
        "restic",
        "OpenBao",
        "SOPS",
        "age",
        "Cosign",
        "Syft",
        "Trivy",
        "OpenTelemetry",
        "RAUC"
      ],
      "qualification": [
        "G4_115",
        "pre_soak",
        "A3",
        "recovery",
        "backup_restore"
      ]
    }
  },
  "shared_principles": [
    "provider credentials remain node-local and never enter GitHub",
    "control-plane and provider-execution roles are separated",
    "G4 execution uses mh-dev-02 plus mh-dev-03",
    "mh-dev-03 is not a primary provider node",
    "installation is fail-closed: missing package/source is reported, not silently substituted"
  ],
  "storage": {
    "system": "OS, Astra transport/state, Git/worktrees, control/evidence, executables",
    "data": "/srv/mediahub for models,caches,datasets,large artifacts,backups,temp"
  }
}
