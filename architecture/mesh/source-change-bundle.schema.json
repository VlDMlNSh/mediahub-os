{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mediahub.astra.source-change-bundle.v1",
  "title": "MediaHub Astra Source Change Bundle (proposed, untrusted input)",
  "description": "A source-change artifact manifest. Schema conformance is not authorization, signature verification, provenance, or permission to publish.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "bundle_id", "task_id", "command_id", "node_id",
    "base_sha", "target_sha", "patch_sha256", "patch_size", "changed_paths",
    "authorization_context", "created_at", "state"
  ],
  "properties": {
    "schema_version": {"const": "mediahub.astra.source-change-bundle.v1"},
    "bundle_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "command_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "node_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "base_sha": {"type": "string", "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"},
    "target_sha": {"type": "string", "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"},
    "patch_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "patch_size": {"type": "integer", "minimum": 0},
    "changed_paths": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "authorization_context": {
      "type": "object", "additionalProperties": false,
      "required": ["issuer_id", "capability_id", "policy_sha256", "signed_command_sha256"],
      "properties": {
        "issuer_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "capability_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "policy_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "signed_command_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      }
    },
    "created_at": {"type": "integer", "minimum": 0},
    "state": {"const": "PROPOSED_UNVERIFIED"}
  }
}
