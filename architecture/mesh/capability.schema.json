{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mediahub.mesh.capability.v1",
  "title": "MediaHub Mesh Capability",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","capability_id","provider","version","executable","identity_sha256","authority","qualification_state"],
  "properties": {
    "schema_version":{"const":"mediahub.mesh.capability.v1"},
    "capability_id":{"type":"string","minLength":1},
    "provider":{"type":"string","minLength":1},
    "version":{"type":"string","minLength":1},
    "executable":{"type":"string","minLength":1},
    "identity_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
    "authority":{"enum":["NONE","CONTROL","EXECUTION"]},
    "qualification_state":{"type":"string","minLength":1},
    "sandbox":{"type":"string","minLength":1}
  }
}