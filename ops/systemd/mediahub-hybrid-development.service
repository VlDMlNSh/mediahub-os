[Unit]
Description=MediaHub Hybrid Development Controller
After=mediahub-local-autonomous.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mediahub
WorkingDirectory=/home/mediahub/dev/mediahub-os-autonomous
EnvironmentFile=/etc/mediahub/hybrid-development.env
ExecStart=/usr/bin/python3 -m ops.ai.hybrid_development_daemon --session-id ${MH_HYBRID_SESSION_ID} --baseline-sha ${MH_HYBRID_BASELINE_SHA} --r4-sha 471f709f5633feab7aeb62dd3ea52effad6d2bc4 --duration-hours ${MH_HYBRID_DURATION_HOURS} --health-url ${MH_HYBRID_HEALTH_URL} --paths ${MH_HYBRID_PATHS}
Restart=always
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/home/mediahub/dev/mediahub-os-autonomous/.hybrid-development
UMask=0077

[Install]
WantedBy=multi-user.target
