[Unit]
Description=MediaHub Astra GitHub Transport
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mediahub
Group=mediahub
EnvironmentFile=-/etc/mediahub-astra/node.env
EnvironmentFile=-/etc/mediahub-astra/agent.env
Environment=ASTRA_GITHUB_REPO=VlDMlNSh/mediahub-os
Environment=ASTRA_WORKTREE=/home/mediahub/astra-work
Environment=ASTRA_STATE_DIR=/var/lib/mediahub-astra
Environment=ASTRA_GITHUB_REMOTE=git@github.com:VlDMlNSh/mediahub-os.git
Environment=ASTRA_GITHUB_BRANCH=main
Environment=ASTRA_RUNTIME_ROOT=/home/mediahub/astra-work/runtime
ExecStart=/bin/bash -lc 'if [[ ! -d /home/mediahub/astra-work/.git ]]; then git clone --depth=1 --branch main git@github.com:VlDMlNSh/mediahub-os.git /home/mediahub/astra-work; fi; exec /home/mediahub/astra-work/ops/astra-github-bootstrap.sh'
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
