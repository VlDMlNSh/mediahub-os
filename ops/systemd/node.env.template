# /etc/mediahub-astra/node.env — node-local, mode 0600
# Set exactly one ASTRA_NODE_ID for the host.
ASTRA_NODE_ID=REPLACE_WITH_mh-dev-01_OR_mh-dev-02_OR_mh-dev-03
ASTRA_AGENT_ID=A0-ASTRA
ASTRA_POLL_SECONDS=30
ASTRA_CLAIM_LEASE_SECONDS=900
ASTRA_WORKTREE=/home/mediahub/astra-work
ASTRA_STATE_DIR=/var/lib/mediahub-astra
