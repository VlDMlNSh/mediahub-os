[Unit]
Description=MediaHub isolated cloud-agent worker %i
After=local-fs.target

[Service]
Type=simple
User=mediahub
Group=mediahub
WorkingDirectory=/home/mediahub/dev/worktrees/%i
ExecStart=/usr/local/libexec/mediahub-agent-adapter %i
Restart=no
TimeoutStartSec=30
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
UMask=0077

# The adapter is the only permitted bridge to the Alamo control plane.
# No provider credentials are injected here; credentials belong to Alamo.
ReadWritePaths=/home/mediahub/dev/worktrees/%i
ReadOnlyPaths=/home/mediahub/dev/mediahub-os-autonomous

[Install]
WantedBy=multi-user.target
