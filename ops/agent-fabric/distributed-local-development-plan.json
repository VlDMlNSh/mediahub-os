{
  "schema": "mediahub.astra.distributed-local-development-plan.v2",
  "version": 2,
  "authority": "A0-ASTRA-coordination",
  "controller_node": "mh-dev-01",
  "policy": "Every micro-task has one builder, one independent verifier, one exact target SHA, one bounded boundary, and one immutable branch. Only controller-verified evidence may be promoted.",
  "steps": [
    {
      "task_id": "DLD-01",
      "node_id": "mh-dev-02",
      "executor": "codex",
      "verifier": "claude",
      "mission": "Add a focused regression test for the autonomous queue's target-pinned completion evidence.",
      "boundary": [
        "tests/test_autonomous_queue.py"
      ],
      "test_paths": [
        "tests/test_autonomous_queue.py"
      ],
      "forbidden": [
        "runtime/",
        "control/",
        "credentials",
        "user data",
        "production infrastructure"
      ],
      "acceptance": [
        "The new test is deterministic and read-only.",
        "It validates target-SHA-pinned completion evidence.",
        "All autonomous queue tests pass."
      ],
      "timeout_seconds": 900
    },
    {
      "task_id": "DLD-02",
      "node_id": "mh-dev-02",
      "executor": "claude",
      "verifier": "codex",
      "mission": "Add a focused Agent Fabric lease-expiry regression test.",
      "boundary": [
        "tests/test_agent_fabric.py"
      ],
      "test_paths": [
        "tests/test_agent_fabric.py"
      ],
      "forbidden": [
        "runtime/",
        "control/",
        "credentials",
        "user data",
        "production infrastructure"
      ],
      "acceptance": [
        "The new test exercises expiry/reclaim semantics without external services.",
        "It is deterministic.",
        "All Agent Fabric tests pass."
      ],
      "timeout_seconds": 900
    },
    {
      "task_id": "DLD-03",
      "node_id": "Voktors-Mac-mini.local",
      "executor": "codex",
      "verifier": "claude",
      "mission": "Add a compact contract test for the distributed local development plan schema.",
      "boundary": [
        "tests/test_distributed_local_worker.py"
      ],
      "test_paths": [
        "tests/test_distributed_local_worker.py"
      ],
      "forbidden": [
        "runtime/",
        "control/",
        "credentials",
        "user data",
        "production infrastructure"
      ],
      "acceptance": [
        "The test remains local and deterministic.",
        "It validates primary and fast pool bindings.",
        "All distributed worker contract tests pass."
      ],
      "timeout_seconds": 900
    },
    {
      "task_id": "DLD-04",
      "node_id": "Voktors-Mac-mini.local",
      "executor": "claude",
      "verifier": "codex",
      "mission": "Document the canonical distributed local development topology and promotion rules.",
      "boundary": [
        "docs/operations/"
      ],
      "test_paths": [],
      "forbidden": [
        "runtime/",
        "control/",
        "credentials",
        "user data",
        "production infrastructure"
      ],
      "acceptance": [
        "The topology names controller, primary pool, fast pool, builder/verifier split, target-SHA binding, and fail-closed promotion.",
        "No secrets or credentials are included."
      ],
      "timeout_seconds": 900
    }
  ],
  "promotion": {
    "mode": "fail_closed",
    "controller_verifies_before_promotion": true,
    "main_direct_write": false,
    "requires_fresh_target_sha": true,
    "requires_disjoint_claims": true
  },
  "execution_fencing": {
    "stale_run_reaper": "per_workflow_active_runs",
    "source_of_truth": "live_main_head",
    "cancel_only_when_head_sha_differs": true
  },
  "executor_pools": [
    {
      "node_id": "mh-dev-01",
      "role": "controller-local-executor-lane",
      "runner_label": "mediahub-control",
      "model": "qwen2.5-coder:1.5b",
      "executor": "claude",
      "purpose": "permanent_claude_executor_lane"
    },
    {
      "node_id": "mh-dev-02",
      "role": "primary-local-executor-pool",
      "runner_label": "mediahub-provider",
      "model": "qwen2.5-coder:3b",
      "executor": "codex",
      "purpose": "permanent_codex_executor_lane"
    },
    {
      "node_id": "Voktors-Mac-mini.local",
      "role": "fast-local-executor-pool",
      "runner_label": "astra-control",
      "model": "qwen2.5-coder:1.5b",
      "executor": "claude",
      "purpose": "permanent_claude_executor_lane"
    }
  ],
  "max_parallel_claims": 3,
  "permanent_executor_rule": "Exactly three permanent executor lanes exist; at most three autonomous claims may execute concurrently. Controller authority remains separate from executor authority.",
  "executor_lanes": [
    {
      "node_id": "mh-dev-01",
      "executor": "claude",
      "model": "qwen2.5-coder:1.5b",
      "role": "controller-local-executor-lane"
    },
    {
      "node_id": "mh-dev-02",
      "executor": "codex",
      "model": "qwen2.5-coder:3b",
      "role": "primary-local-executor-pool"
    },
    {
      "node_id": "Voktors-Mac-mini.local",
      "executor": "claude",
      "model": "qwen2.5-coder:1.5b",
      "role": "fast-local-executor-pool"
    }
  ],
  "concurrency": {
    "max_parallel_claims": 3,
    "require_disjoint_claims": true,
    "shared_surfaces_serialized": true
  }
}
