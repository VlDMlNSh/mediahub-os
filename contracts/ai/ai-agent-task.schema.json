{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mediahub://contracts/ai/ai-agent-task.schema.json",
  "title": "MediaHub AI Agent Task",
  "description": "Bounded task envelope for advisory specialist-agent work. The agent has no authority over MediaHub state, authorization, verification, release, or production decisions.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_id": { "type": "string", "const": "mediahub.ai.ai-agent-task" },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "owner": { "type": "string", "const": "mediahub-ai" },
    "task_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "context": { "type": "object", "additionalProperties": true },
    "constraints": { "type": "object", "additionalProperties": true },
    "authorization": { "type": "object", "additionalProperties": true },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["schema_id", "schema_version", "owner", "task_id", "agent_id", "objective", "context", "constraints", "authorization"]
}
