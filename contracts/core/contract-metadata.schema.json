{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mediahub://contracts/core/contract-metadata.schema.json",
  "title": "MediaHub OS Contract Metadata",
  "description": "Common machine-readable metadata boundary for MediaHub OS foundation contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "owner",
    "required",
    "optional",
    "constraints"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "required": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "optional": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
