{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mediahub://schemas/domain/state.schema.json",
  "title": "MediaHub OS Actual State",
  "description": "Canonical representation of observed or inferred physical state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "property",
    "value",
    "unit",
    "timestamp",
    "source",
    "confidence",
    "validity"
  ],
  "properties": {
    "property": {
      "type": "string",
      "minLength": 1
    },
    "value": {},
    "unit": {
      "type": ["string", "null"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "enum": [
        "DEVICE",
        "PROTOCOL",
        "INTERNAL",
        "INFERRED",
        "USER",
        "AUTOMATION",
        "AI",
        "CLOUD"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "validity": {
      "enum": [
        "VALID",
        "STALE",
        "UNKNOWN",
        "CONFLICTED",
        "INVALID"
      ]
    }
  }
}
