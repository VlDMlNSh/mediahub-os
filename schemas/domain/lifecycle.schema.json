{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mediahub://schemas/domain/lifecycle.schema.json",
  "title": "MediaHub OS Lifecycle",
  "description": "Canonical lifecycle state of a MediaHub Device.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "timestamp",
    "reason"
  ],
  "properties": {
    "state": {
      "enum": [
        "DISCOVERED",
        "IDENTIFIED",
        "ONBOARDING",
        "ACTIVE",
        "OFFLINE",
        "DEGRADED",
        "RETIRED"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
