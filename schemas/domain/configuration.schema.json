{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mediahub://schemas/domain/configuration.schema.json",
  "title": "MediaHub OS Configuration",
  "description": "Canonical device configuration distinct from physical state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "properties",
    "timestamp"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": [
        "FACTORY",
        "PROJECT",
        "USER",
        "AUTOMATION",
        "POLICY",
        "CLOUD",
        "AI"
      ]
    },
    "properties": {
      "type": "object"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
