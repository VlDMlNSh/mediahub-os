{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mediahub://contracts/ai/ai-agent-admission.schema.json",
  "title": "MediaHub AI Agent Admission Record",
  "description": "PROPOSED additive admission record linked to profiles/agent-registry.json. This record grants no authority by itself and does not replace A0, MH-12, MH-21, R-06 or ASTRA G0-G11 gates. All credential fields are opaque references; credential material is forbidden.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_id": { "type": "string", "const": "mediahub.ai.agent-admission" },
    "schema_version": { "type": "string", "const": "0.1.0" },
    "agent_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "catalog_ref": { "type": "string", "const": "profiles/agent-registry.json" },
    "catalog_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "catalog_blob_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "integration_kind": {
      "type": "string",
      "enum": ["github_app", "github_actions_worker", "hosted_saas_agent", "cloud_worker_api", "provider_gateway", "local_worker", "local_tooling"]
    },
    "provider_id": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "provider_account_ref": { "type": ["string", "null"], "minLength": 1 },
    "provider_project_ref": { "type": ["string", "null"], "minLength": 1 },
    "repository_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repositories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "paths_read": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "paths_write": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      },
      "required": ["repositories", "refs", "paths_read", "paths_write"]
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auth_mode": {
          "type": "string",
          "enum": ["github_app", "oauth", "oidc_workload_identity", "scoped_secret_ref", "local_process_identity", "none"]
        },
        "credential_ref": { "type": ["string", "null"], "minLength": 1 },
        "last_auth_evidence_ref": { "type": ["string", "null"], "minLength": 1 },
        "checked_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "required": ["auth_mode", "credential_ref", "last_auth_evidence_ref", "checked_at"]
    },
    "provider_routes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
          "model_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "endpoint_policy_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
          "region_policy_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
          "allowed_data_class_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 256 }
          },
          "terms_evidence_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
          "expires_at": { "type": "string", "format": "date-time" }
        },
        "required": ["provider_id", "model_id", "endpoint_policy_ref", "region_policy_ref", "allowed_data_class_refs", "terms_evidence_ref", "expires_at"]
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["read_repository", "inspect_public_docs", "run_approved_tests", "create_topic_branch", "create_pull_request", "write_allowlisted_paths"]
      }
    },
    "write_mode": { "type": "string", "enum": ["read_only", "topic_branch_pr"] },
    "admission_state": {
      "type": "string",
      "enum": ["DISCOVERED", "REVIEW_PENDING", "WAITING_AUTH", "AUTH_VERIFIED", "READ_ONLY_ADMITTED", "PATCH_ADMITTED", "QUALIFIED", "ACTIVE", "DEGRADED", "BLOCKED", "QUARANTINED", "REVOKED", "EXPIRED"]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 3 },
        "max_provider_requests": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "input_token_budget": { "type": "integer", "minimum": 0 },
        "output_token_budget": { "type": "integer", "minimum": 0 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 900 },
        "retry_budget": { "type": "integer", "minimum": 0, "maximum": 8 },
        "cost_ceiling_usd": { "type": "number", "minimum": 0 },
        "paid_fallback_allowed": { "type": "boolean" }
      },
      "required": ["max_concurrency", "max_provider_requests", "input_token_budget", "output_token_budget", "timeout_seconds", "retry_budget", "cost_ceiling_usd", "paid_fallback_allowed"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "policy_revision": { "type": "string", "minLength": 1, "maxLength": 256 },
        "reviewer_ref": { "type": ["string", "null"], "minLength": 1 },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "auth_probe_ref": { "type": ["string", "null"], "minLength": 1 },
        "security_review_ref": { "type": ["string", "null"], "minLength": 1 },
        "privacy_review_ref": { "type": ["string", "null"], "minLength": 1 },
        "independent_verification_ref": { "type": ["string", "null"], "minLength": 1 },
        "terms_review_ref": { "type": ["string", "null"], "minLength": 1 }
      },
      "required": ["source_commit_sha", "policy_revision", "reviewer_ref", "reviewed_at", "expires_at", "auth_probe_ref", "security_review_ref", "privacy_review_ref", "independent_verification_ref", "terms_review_ref"]
    }
  },
  "required": ["schema_id", "schema_version", "agent_id", "catalog_ref", "catalog_version", "catalog_blob_sha", "integration_kind", "provider_id", "provider_account_ref", "provider_project_ref", "repository_scope", "auth", "provider_routes", "capabilities", "write_mode", "admission_state", "limits", "evidence"],
  "allOf": [
    {
      "if": { "properties": { "write_mode": { "const": "read_only" } }, "required": ["write_mode"] },
      "then": {
        "properties": {
          "repository_scope": { "properties": { "paths_write": { "maxItems": 0 } } },
          "capabilities": {
            "not": {
              "contains": { "enum": ["create_topic_branch", "create_pull_request", "write_allowlisted_paths"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "write_mode": { "const": "topic_branch_pr" } }, "required": ["write_mode"] },
      "then": {
        "properties": { "repository_scope": { "properties": { "paths_write": { "minItems": 1 } } } }
      }
    },
    {
      "if": { "properties": { "admission_state": { "enum": ["AUTH_VERIFIED", "READ_ONLY_ADMITTED", "PATCH_ADMITTED", "QUALIFIED", "ACTIVE"] } }, "required": ["admission_state"] },
      "then": {
        "properties": {
          "auth": { "properties": { "last_auth_evidence_ref": { "type": "string", "minLength": 1 }, "checked_at": { "type": "string", "format": "date-time" } } },
          "evidence": {
            "properties": {
              "auth_probe_ref": { "type": "string", "minLength": 1 },
              "reviewer_ref": { "type": "string", "minLength": 1 },
              "reviewed_at": { "type": "string", "format": "date-time" },
              "security_review_ref": { "type": "string", "minLength": 1 },
              "privacy_review_ref": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "admission_state": { "const": "PATCH_ADMITTED" } }, "required": ["admission_state"] },
      "then": {
        "properties": {
          "write_mode": { "const": "topic_branch_pr" },
          "capabilities": {
            "allOf": [
              { "contains": { "const": "create_topic_branch" } },
              { "contains": { "const": "create_pull_request" } },
              { "contains": { "const": "write_allowlisted_paths" } }
            ]
          },
          "evidence": {
            "properties": {
              "independent_verification_ref": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "admission_state": { "enum": ["QUALIFIED", "ACTIVE"] } }, "required": ["admission_state"] },
      "then": {
        "properties": {
          "evidence": { "properties": { "independent_verification_ref": { "type": "string", "minLength": 1 } } }
        }
      }
    },
    {
      "if": { "properties": { "limits": { "properties": { "paid_fallback_allowed": { "const": false } }, "required": ["paid_fallback_allowed"] } }, "required": ["limits"] },
      "then": { "properties": { "limits": { "properties": { "cost_ceiling_usd": { "const": 0 } } } }
    }
  ]
}
