{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mediahub.ai.ai-model",
  "title": "MediaHub AI Model",
  "description": "Canonical contract describing an AI model registered in MediaHub.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "mediahub.ai.ai-model"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "owner": {
      "type": "string",
      "const": "mediahub-ai"
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "model_name": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_family": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "deprecated"
      ]
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "owner",
    "model_id",
    "provider_id",
    "model_name",
    "model_version",
    "model_family",
    "status"
  ]
}
